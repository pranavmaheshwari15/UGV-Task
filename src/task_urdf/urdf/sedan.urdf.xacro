<?xml version="1.0"?>
<robot name="ugv_sedan" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ===================== GAZEBO DIFF-DRIVE PLUGIN ===================== -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">

      <update_rate>50</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>

      <!-- Left Wheels -->
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <!-- Right Wheels -->
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Kinematics (Exact match to URDF wheel_y * 2) -->
      <wheel_separation>0.45</wheel_separation>
      <wheel_diameter>0.18</wheel_diameter>

      <!-- Balanced Torque & Acceleration for Controlled Tight Arcs -->
      <max_wheel_torque>300</max_wheel_torque>
      <max_wheel_acceleration>20.0</max_wheel_acceleration>

      <!-- Topic & Frames -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <!-- Flags -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>

    </plugin>
  </gazebo>

  <!-- ===================== PROPERTIES ===================== -->
  <xacro:property name="PI" value="3.14159265359"/>

  <!-- Chassis -->
  <xacro:property name="chassis_l" value="0.85"/>
  <xacro:property name="chassis_w" value="0.40"/>
  <xacro:property name="chassis_h" value="0.15"/>
  <xacro:property name="chassis_m" value="3.0"/>

  <!-- Cabin -->
  <xacro:property name="cabin_l" value="0.35"/>
  <xacro:property name="cabin_w" value="0.40"/>
  <xacro:property name="cabin_h" value="0.125"/>
  <xacro:property name="cabin_m" value="1.0"/>
  <xacro:property name="cabin_x" value="-0.05"/>

  <!-- Glass -->
  <xacro:property name="glass_t" value="0.005"/>
  <xacro:property name="glass_m" value="0.1"/>
  <xacro:property name="glass_run" value="0.10"/>
  <xacro:property name="glass_len" value="${sqrt(glass_run*glass_run + cabin_h*cabin_h)}"/>
  <xacro:property name="glass_pitch" value="${atan2(glass_run, cabin_h)}"/>

  <!-- Wheels -->
  <xacro:property name="wheel_r" value="0.09"/>
  <xacro:property name="wheel_h" value="0.05"/>
  <xacro:property name="wheel_m" value="0.3"/>
  <xacro:property name="wheel_x" value="0.25"/>
  <xacro:property name="wheel_y" value="0.225"/>

  <!-- Lights -->
  <xacro:property name="light_r" value="0.03"/>
  <xacro:property name="light_t" value="0.01"/>
  <xacro:property name="light_m" value="0.015"/>
  <xacro:property name="light_y" value="0.14"/>

  <!-- Ground clearance -->
  <xacro:property name="clearance" value="0.05"/>
  <xacro:property name="base_z" value="${clearance + chassis_h/2}"/>

  <!-- ===================== MATERIALS ===================== -->
  <material name="body_blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>
  <material name="cabin_grey">
    <color rgba="0.6 0.7 0.8 1.0"/>
  </material>
  <material name="glass">
    <color rgba="0.2 0.35 0.5 0.6"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="light_white">
    <color rgba="1.0 1.0 0.8 1.0"/>
  </material>
  <material name="light_red">
    <color rgba="0.9 0.05 0.05 1.0"/>
  </material>

  <!-- ===================== INERTIA MACROS ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12.0*(y*y+z*z)}" ixy="0" ixz="0" iyy="${m/12.0*(x*x+z*z)}" iyz="0" izz="${m/12.0*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12.0*(3*r*r+h*h)}" ixy="0" ixz="0" iyy="${m/12.0*(3*r*r+h*h)}" iyz="0" izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="disc_x_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*r*r/2.0}" ixy="0" ixz="0" iyy="${m/12.0*(3*r*r+h*h)}" iyz="0" izz="${m/12.0*(3*r*r+h*h)}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== LINKS & JOINTS ===================== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_l} ${chassis_w} ${chassis_h}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_m}" x="${chassis_l}" y="${chassis_w}" z="${chassis_h}"/>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <!-- Cabin -->
  <link name="cabin_link">
    <visual>
      <geometry>
        <box size="${cabin_l} ${cabin_w} ${cabin_h}"/>
      </geometry>
      <material name="cabin_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="${cabin_l} ${cabin_w} ${cabin_h}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${cabin_m}" x="${cabin_l}" y="${cabin_w}" z="${cabin_h}"/>
  </link>

  <joint name="cabin_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cabin_link"/>
    <origin xyz="${cabin_x} 0 ${chassis_h/2 + cabin_h/2}" rpy="0 0 0"/>
  </joint>

  <!-- Glass Macro -->
  <xacro:macro name="glass_panel" params="name side slope">
    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="${glass_t} ${cabin_w} ${glass_len}"/>
        </geometry>
        <material name="glass"/>
      </visual>
      <collision>
        <geometry>
          <box size="${glass_t} ${cabin_w} ${glass_len}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="${glass_m}" x="${glass_t}" y="${cabin_w}" z="${glass_len}"/>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="cabin_link"/>
      <child link="${name}_link"/>
      <origin xyz="${side*(cabin_l/2 + glass_run/2)} 0 0" rpy="0 ${slope*glass_pitch} 0"/>
    </joint>
  </xacro:macro>

  <xacro:glass_panel name="windshield" side="1" slope="-1"/>
  <xacro:glass_panel name="rear_window" side="-1" slope="1"/>

  <!-- Wheel Macro tuned for Moderate Friction and Small Turns -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_h}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_h}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_m}" r="${wheel_r}" h="${wheel_h}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} ${wheel_r - base_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <gazebo reference="${name}_wheel_link">
      <mu1>0.3</mu1>
      <mu2>0.3</mu2>
      <slip1>0.2</slip1>
      <slip2>0.2</slip2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="front_left" x="${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="front_right" x="${wheel_x}" y="${-1*wheel_y}"/>
  <xacro:wheel name="rear_left" x="${-1*wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="rear_right" x="${-1*wheel_x}" y="${-1*wheel_y}"/>

  <!-- Light Macro -->
  <xacro:macro name="light" params="name x y material">
    <link name="${name}_light_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 ${PI/2} 0"/>
        <geometry>
          <cylinder radius="${light_r}" length="${light_t}"/>
        </geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 ${PI/2} 0"/>
        <geometry>
          <cylinder radius="${light_r}" length="${light_t}"/>
        </geometry>
      </collision>
      <xacro:disc_x_inertia m="${light_m}" r="${light_r}" h="${light_t}"/>
    </link>

    <joint name="${name}_light_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_light_link"/>
      <origin xyz="${x} ${y} 0.03" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:property name="light_x" value="${chassis_l/2 + light_t/2}"/>
  <xacro:light name="front_left" x="${light_x}" y="${light_y}" material="light_white"/>
  <xacro:light name="front_right" x="${light_x}" y="${-1*light_y}" material="light_white"/>
  <xacro:light name="rear_left" x="${-1*light_x}" y="${light_y}" material="light_red"/>
  <xacro:light name="rear_right" x="${-1*light_x}" y="${-1*light_y}" material="light_red"/>

</robot>
